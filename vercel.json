{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx pnpm@9.15.5 --dir frontend install",
  "buildCommand": "npx pnpm@9.15.5 --dir frontend build",
  "outputDirectory": "frontend/apps/web/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
